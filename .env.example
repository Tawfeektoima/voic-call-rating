# === Security ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_generated_32_char_secret_key_here
ENVIRONMENT=development
LIVE_PIPELINE_ENABLED=false
ENABLE_STARTUP_RECOVERY=false

# === Database ===
DATABASE_URL=sqlite:///./call_rating.db
POSTGRES_USER=call_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=call_rating

# === Redis & Celery ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_URL=
CELERY_BROKER_URL=

# === HuggingFace (Pyannote diarization) ===
HF_TOKEN=your_huggingface_token

# === Groq LLM ===
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# === Audio Upload ===
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=.wav,.mp3,.m4a,.ogg,.flac,.webm
FRONTEND_URL=http://localhost:5173

# === Production example ===
# ENVIRONMENT=production
# DATABASE_URL=postgresql://call_admin:CHANGE_ME@postgres:5432/call_rating
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=CHANGE_ME
# FRONTEND_URL=https://your-frontend.example.com
