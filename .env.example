# === Security ===
-# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
-SECRET_KEY=your_generated_32_char_secret_key_here
-# Set to "production" on live servers to enforce PostgreSQL
-ENVIRONMENT=development
-
-# === Database ===
--POSTGRES_USER=call_admin
-POSTGRES_PASSWORD=CHANGE_ME
-POSTGRES_DB=call_rating
-DATABASE_URL=postgresql://call_admin:CHANGE_ME@localhost:5432/call_rating
-
-# === HuggingFace (Pyannote diarization) ===
-HF_TOKEN=your_huggingface_token
-
-# === Groq LLM ===
-GROQ_API_KEY=your_groq_api_key
-
-# === Audio Upload ===
-UPLOAD_DIR=uploads
-MAX_FILE_SIZE_MB=100
-ALLOWED_EXTENSIONS=.wav,.mp3,.m4a,.ogg,.flac,.webm
-
