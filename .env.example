# === Security ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_generated_32_char_secret_key_here
ENVIRONMENT=development
LIVE_PIPELINE_ENABLED=false
ENABLE_STARTUP_RECOVERY=false
# Required only when running setup_admin.py to create/update the bootstrap admin.
# Use a one-time strong value and rotate it after first login.
VOICEQA_BOOTSTRAP_ADMIN_CREDENTIAL=CHANGE_ME_STRONG_TEMPORARY_VALUE

# === Call Ingestion ===
CALL_INGEST_ENABLED=false
CALL_INGEST_GOOGLE_SHEET_ID=<google-sheet-id>
CALL_INGEST_WORKSHEET=الورقة1
CALL_INGEST_RANGE=A:ZZ
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/vicdi-sheets-reader.json
# VM-local credential file mounted read-only as the Compose secret above.
GOOGLE_SERVICE_ACCOUNT_FILE_HOST=/var/lib/call-rating/secrets/vicdi-sheets-reader.json
CALL_INGEST_VM_STORAGE_ROOT=/var/lib/call-rating
CALL_INGEST_DEFAULT_CAMPAIGN_ID=0
CALL_INGEST_ALLOWED_RECORDING_HOSTS=archive.dial-fusion.com
CALL_INGEST_INTERVAL_MINUTES=15
CALL_INGEST_DOWNLOAD_CONCURRENCY=4
CALL_INGEST_RETRY_LIMIT=3
CALL_INGEST_REQUEST_TIMEOUT_SECONDS=30
CALL_INGEST_QUARANTINE_DIR=/var/lib/call-rating/quarantine
CALL_INGEST_ACCEPTED_DIR=/var/lib/call-rating/accepted
CALL_INGEST_REJECTED_DIR=/var/lib/call-rating/rejected
CALL_INGEST_SCANNER=clamd
CALL_INGEST_SCANNER_ENDPOINT=/run/clamav/clamd.ctl
CALL_INGEST_MEDIA_VERIFIER_ENDPOINT=http://media-verifier:8090
# Production services must use split roles: api, gpu_worker, downloader, inspector, scheduler.
CALL_INGEST_RUNTIME_ROLE=all
CALL_INGEST_INSPECTION_TIMEOUT_SECONDS=60
CALL_INGEST_MEDIA_VERIFY_TIMEOUT_SECONDS=60

# === Database ===
DATABASE_URL=sqlite:///./call_rating.db
POSTGRES_USER=call_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=call_rating

# === Redis & Celery ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_URL=
CELERY_BROKER_URL=

# === HuggingFace (Pyannote diarization) ===
HF_TOKEN=your_huggingface_token

# === Groq LLM ===
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# === Audio Upload ===
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=.wav,.mp3,.m4a,.ogg,.flac,.webm
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=
INTERVIEW_PORTAL_PATH=/interview-portal
REQUIRE_PUBLIC_BASE_URL_FOR_INTERVIEWS=false
ENABLE_PUBLIC_BASE_URL_HEALTHCHECK=false
INTERVIEW_SESSION_EXPIRY_HOURS=24
INTERVIEW_APPLICATION_COOLDOWN_DAYS=30
INTERVIEW_DUPLICATE_WINDOW_SECONDS=600
INTERVIEW_QUESTION_TIME_LIMIT_SECONDS=180
INTERVIEW_DOCUMENT_ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx
GENERATED_EMAIL_DOMAIN=EIACS.com
GENERATED_EMAIL_PREFIX=emp
LOGIN_OTP_REQUIRED=false
LOGIN_OTP_EXPIRE_MINUTES=5
LOGIN_OTP_MAX_ATTEMPTS=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_sender@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_sender@gmail.com
SMTP_USE_TLS=true
BCRYPT_ROUNDS=12
DEFAULT_EMPLOYEE_PASSWORD=Eiacs$1234#

# Security policy rollout (Protect Architecture)
# See docs/protect_rollout_runbook.md for the full rollout guide.
#
# SECURITY_POLICY_MODE controls the security engine:
#   off     = No shift/device/session checks. Current behavior. (default)
#   audit   = Evaluate all checks, log violations, but never block users.
#   enforce = Evaluate all checks and block policy violations.
#
# Rollout order: off → audit (review logs) → enforce
# Rollback:      enforce → audit (if issues) → off (emergency only)
SECURITY_POLICY_MODE=off

# Timezone for shift window calculations (must be a valid IANA timezone)
SECURITY_TIMEZONE=Africa/Cairo

# Grace period (minutes) before shift start / after shift end
# Range: 0–240. Recommended production: 15
DEFAULT_SHIFT_GRACE_BEFORE_MINUTES=10
DEFAULT_SHIFT_GRACE_AFTER_MINUTES=10

# WebSocket mid-connection revalidation interval (seconds)
# Lower = tighter security but more DB queries. 0 = disable revalidation.
# Recommended production: 30
SECURITY_WS_REVALIDATION_INTERVAL_SECONDS=15

# === Production example ===
# ENVIRONMENT=production
# DATABASE_URL=postgresql://call_admin:CHANGE_ME@postgres:5432/call_rating
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=CHANGE_ME
# FRONTEND_URL=https://your-frontend.example.com
# PUBLIC_BASE_URL=https://your-public-tunnel-or-frontend.example.com
